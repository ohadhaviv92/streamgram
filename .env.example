# Environment
NODE_ENV=
# Server configuration
PORT=
# Public HTTPS base URL for Stremio addon and stream links
PUBLIC_URL=
# Telegram API configuration
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TMDB API configuration
TMDB_BEARER_TOKEN=
# Language configuration
PREFERRED_LANGUAGE=


# Persistence backend: json (default) or sqlite; restart after changing
STORAGE_DRIVER=json
# Private directory for config.json or config.sqlite
DATA_DIR=data
